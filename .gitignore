# .gitignore - Archivos ignorados para proyecto React

# Dependencias
/node_modules
/.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Producción
/build
/dist

# Variables de entorno
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Archivos de sistema operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Archivos del IDE
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ
.idea/
*.iws
*.iml
*.ipr

# Archivos de desarrollo
coverage/
*.log
logs/

# Archivos temporales
*.tmp
*.temp

# Archivos de sistema
.history/
*.swp
*.swo

# Archivos de paquetes
package-lock.json
yarn.lock
pnpm-lock.yaml

# Archivos de caché
.cache/
.next/
.nuxt/
.cache-loader/

# Archivos de testing
.nyc_output

# Archivos de misceláneos
*.sass-cache/
*.class
*.exe
*.dll
*.obj
*.pdb
*.lib
*.so
*.dylib
*.ncb
*.sdf
*.suo
*.aps
*.ilk
*.log